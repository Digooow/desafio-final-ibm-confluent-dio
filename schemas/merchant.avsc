{
  "type": "record",
  "namespace": "com.bootcamp.payments",
  "name": "Merchant",
  "doc": "Estabelecimentos comerciais onde ocorrem transações",
  "fields": [
    {
      "name": "merchant_id",
      "type": "long",
      "doc": "Identificador único do lojista"
    },
    {
      "name": "name",
      "type": "string",
      "doc": "Nome comercial do estabelecimento"
    },
    {
      "name": "category_code",
      "type": "string",
      "doc": "Código MCC (Merchant Category Code)"
    },
    {
      "name": "country",
      "type": "string",
      "default": "BR",
      "doc": "País ISO-3166 alpha-2"
    },
    {
      "name": "risk_level",
      "type": "string",
      "default": "LOW",
      "doc": "Classificação de risco do lojista (LOW, MEDIUM, HIGH)"
    }
  ]
}

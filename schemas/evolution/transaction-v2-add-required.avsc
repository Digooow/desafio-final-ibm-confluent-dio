{
  "type": "record",
  "namespace": "com.bootcamp.payments",
  "name": "Transaction",
  "doc": "Teste de quebra de contrato BACKWARD: adiciona campo obrigatório 'risk_score' sem default",
  "fields": [
    {
      "name": "transaction_id",
      "type": "long"
    },
    {
      "name": "account_id",
      "type": "long"
    },
    {
      "name": "card_id",
      "type": "long",
      "confluent:tags": ["PCI"]
    },
    {
      "name": "merchant_id",
      "type": "long"
    },
    {
      "name": "amount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 15,
        "scale": 2
      }
    },
    {
      "name": "currency",
      "type": "string",
      "default": "BRL"
    },
    {
      "name": "status",
      "type": "string"
    },
    {
      "name": "channel",
      "type": "string"
    },
    {
      "name": "created_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "risk_score",
      "type": "int"
    }
  ]
}

# ==============================================================================
# Desafio Final IBM + Confluent (DIO) — Modelo de Variáveis de Ambiente
# Copie este arquivo para `.env` e preencha com suas credenciais reais.
# NUNCA versione o arquivo `.env` no Git!
# ==============================================================================

# --- Camada 1: Confluent Cloud (Fundação & Identidades) ---
CONFLUENT_ENV_NAME=desafio-final
CONFLUENT_CLUSTER_NAME=desafio-basic
CONFLUENT_CLOUD_PROVIDER=aws
CONFLUENT_CLOUD_REGION=us-east-1

# Preenchidos após criar o cluster e as Service Accounts (setup.sh)
KAFKA_BOOTSTRAP_SERVERS=
PRODUCER_API_KEY=
PRODUCER_API_SECRET=
CONSUMER_API_KEY=
CONSUMER_API_SECRET=

# --- Camada 2: Schema Registry ---
SCHEMA_REGISTRY_URL=
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

# --- Camada 3: Neon Postgres & Conector CDC ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PG_HOST=
PG_PORT=5432
PG_DATABASE=neondb
PG_SSLMODE=require
PG_ADMIN_USER=
PG_ADMIN_PASSWORD=

# Usuário dedicado de menor privilégio para o Debezium (PostgresCdcSourceV2)
PG_CDC_USER=cdc_user
PG_CDC_PASSWORD=

# --- Camada 4 & 5: Flink SQL & Observabilidade ---
CONFLUENT_ENV_ID=
CONFLUENT_CLUSTER_ID=
METRICS_API_KEY=
METRICS_API_SECRET=

# === Confluent Cloud Flink ===
FLINK_COMPUTE_POOL_ID=
FLINK_COMPUTE_POOL_NAME=desafio-flink

